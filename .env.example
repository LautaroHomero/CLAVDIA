# ─── Required ────────────────────────────────────────────────────────────────
# The LLM that powers the agent. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the model (any Anthropic model id). Default: claude-haiku-4-5
# AGENT_MODEL=claude-haiku-4-5

# Session cookie signing secret. In development it falls back to a dev default;
# in production it is REQUIRED and must be >= 32 random chars, or the app refuses
# to start. Generate one with:  openssl rand -base64 48
AUTH_SECRET=cambia-esto-por-algo-random-de-al-menos-32-caracteres

# ─── Optional: Slack human-in-the-loop ───────────────────────────────────────
# If these are NOT set, approval/clarification requests still work — they show
# up in the web UI's "Pendientes de un humano" panel instead of Slack.
#
# Create an app at https://api.slack.com/apps (see README for the exact steps).
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Channel ID (not name) where approval requests are posted, e.g. C0123ABCDE
SLACK_APPROVAL_CHANNEL=C0123ABCDE
