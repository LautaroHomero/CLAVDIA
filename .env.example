# ─── Required ────────────────────────────────────────────────────────────────
# The LLM that powers the agent. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Postgres (Supabase). In the project's Settings → Database → "Connect", copy
# BOTH from the pooler tabs — NOT "Direct connection": that host is IPv6-only
# (no A record) and times out (CONNECT_TIMEOUT) on most home/office networks.
#  - DATABASE_URL: "Transaction pooler" (port 6543) — what the app uses at
#    runtime. The client already sets `prepare: false`, required for it.
#  - DATABASE_URL_DIRECT: "Session pooler" (port 5432, same pooler host) —
#    only used by `npm run db:migrate`, never by the running app. Session mode
#    supports the DDL a migration needs, and it's IPv4 like the transaction one.
# Point these at a different Supabase project (dev/test/prod) to target that
# environment; the app itself doesn't know about environments, only the URL.
DATABASE_URL=postgres://postgres.xxxxxxxxxxxx:xxxxxxxx@aws-x-xx-xxxx-x.pooler.supabase.com:6543/postgres
DATABASE_URL_DIRECT=postgres://postgres.xxxxxxxxxxxx:xxxxxxxx@aws-x-xx-xxxx-x.pooler.supabase.com:5432/postgres

# Optional: override the model (any Anthropic model id). Default: claude-haiku-4-5
# AGENT_MODEL=claude-haiku-4-5

# Session cookie signing secret. In development it falls back to a dev default;
# in production it is REQUIRED and must be >= 32 random chars, or the app refuses
# to start. Generate one with:  openssl rand -base64 48
AUTH_SECRET=cambia-esto-por-algo-random-de-al-menos-32-caracteres

# ─── Optional: outbound notifications (patient PIN-recovery codes) ───────────
# Transport for the one-time codes. Default: "log" — prints the code to the
# server console, enough for dev and a first deploy. Real transports (resend,
# twilio) are added in src/lib/notify and selected here.
# NOTIFY_TRANSPORT=log
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── Optional: Slack human-in-the-loop ───────────────────────────────────────
# If these are NOT set, approval/clarification requests still work — they show
# up in the web UI's "Pendientes de un humano" panel instead of Slack.
#
# Create an app at https://api.slack.com/apps (see README for the exact steps).
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Channel ID (not name) where approval requests are posted, e.g. C0123ABCDE
SLACK_APPROVAL_CHANNEL=C0123ABCDE
